 	init_rwsem(&mapping->i_mmap_rwsem);
 	INIT_LIST_HEAD(&mapping->i_private_list);
@@ -518,6 +522,19 @@ static void address_space_free(struct address_space *mapping) {
 	}
 	mtree_destroy(&mapping->i_mm_access_bits);
 }
+#ifdef CONFIG_PAGE_CACHE_ISOLATION_MIMIC_IO
+void address_space_free_mimic_mapping(struct address_space **mimic_mapping)
+{
+	if (!*mimic_mapping)
+		return;
+
+	truncate_inode_pages(*mimic_mapping, 0);
