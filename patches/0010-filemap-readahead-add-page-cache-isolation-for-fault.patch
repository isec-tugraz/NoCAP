+typedef int (*transfer_access_state_waitlock_fn)(struct folio *, void *);
+static int __filemap_transfer_async_accessed_state(struct address_space *mapping,
+		off_t start_idx, off_t end_idx, struct xarray *bits_arr,
+		transfer_access_state_waitlock_fn waitlock_fn,
+		void *waitlock_data)
+{
+	int err;
+
+	if (!mapping->i_mm_async_mimic_mapping)
+		return 0;
+
+	/* Check if there is anything overlapping this range in the fake async mapping */
+	for (size_t i = start_idx; i <= end_idx; i++) {
+		struct folio *folio;
+
+retry:
+		folio = filemap_get_folio(mapping->i_mm_async_mimic_mapping, i);
+		if (IS_ERR(folio)) {
+			if (PTR_ERR(folio) == -ENOENT)
+				continue;
+			else
+				return PTR_ERR(folio);
+		}
+
+		/*
+		 * At this point we actually found a folio that was placed in the simulated async readahead state.
+		 * Now that somebody tried to access it, block the thread until it is uptodate and then set the
+		 * accessed bit accordingly.
+		 * The flag responsible is uptodate - see do_read_cache_folio. locked is only required for _performing_
+		 * operations on the folio.
+		 */
+
+		err = waitlock_fn(folio, waitlock_data);
+		if (err == -EAGAIN)
+			goto retry;
+		else if (err)
+			return err;
+
+		// If the read was not successful but folio is not locked
+		// after an attempted posted readahead, uptodate is not set.
+		// Don't know how to handle it, tho.
+		// TODO
+		if (folio_test_uptodate(folio))
+			_filemap_set_accessed_bits(bits_arr, folio_index(folio), folio_nr_pages(folio), NULL);
+		else
+			WARN_ON_ONCE(1);
+
+		/* get_folio incs the refcount */
+		folio_put(folio);
+	}
+
+	/* Remove the folios - we've transferred the state and do not need to keep hogging the memory */
+	truncate_inode_pages_range(mapping->i_mm_async_mimic_mapping, start_idx, end_idx);
+
+	return 0;
+}
+static int transfer_waitlock_normal(struct folio *folio, void *data)
+{
+	// TODO: do_read_cache_page does read the page syncrhonously itself if it was not cached yet
+	if (folio_test_locked(folio)) {
+		folio_put_wait_locked(folio, TASK_UNINTERRUPTIBLE);
+		/* DROP does not check the bit due to dropping the ref - retry to prevent spurious wakeup */
+		return -EAGAIN;
+	}
+	return 0;
+}
+static int _filemap_transfer_async_accessed_state(struct address_space *mapping,
+		off_t start_idx, off_t end_idx, struct xarray *bits_arr)
+{
+	return __filemap_transfer_async_accessed_state(mapping, start_idx, end_idx,
+			bits_arr, transfer_waitlock_normal, NULL);
+}
+static int filemap_peek_transfer_async_accessed_state(struct address_space *mapping,
+		pgoff_t start_pgoff, pgoff_t end_pgoff)
+{
+	int ret;
+	struct xarray *bits_arr;
+	struct mm_struct *mm;
+
+	if (!mapping->i_mm_async_mimic_mapping)
+		return 0;
+
+	mm = current ? current->mm : NULL;
+
+	ret = filemap_get_access_bitmask(mapping, mm, &bits_arr);
+	if (ret)
+		return ret;
+
+	for (size_t i = start_pgoff; i <= end_pgoff; i++) {
+		struct folio *folio;
+
+		folio = filemap_get_folio(mapping->i_mm_async_mimic_mapping, i);
+		if (IS_ERR(folio)) {
+			if (PTR_ERR(folio) == -ENOENT)
+				continue;
+			else
+				return PTR_ERR(folio);
+		}
+
+		/* Only apply the bitmask if the folio is done, i.e. not locked anymore and uptodate */
+		if (!folio_test_locked(folio) && folio_test_uptodate(folio)) {
+			_filemap_set_accessed_bits(bits_arr, folio_index(folio), folio_nr_pages(folio), NULL);
+			/*
+			 * Only attempt to lock and remove the folio. If we cannot because somebody was quicker
+			 * than us, we'll just carry on instead of locking up the fault handling.
+			 * This means we may double-set bits if we encounter the uptodate folio again,
+			 * but this is better than blocking.
+			 */
+			if (folio_trylock(folio)) {
+				mapping_evict_folio(mapping->i_mm_async_mimic_mapping, folio);
+				folio_unlock(folio);
+			}
+		}
+
+		/* get_folio incs the refcount */
+		folio_put(folio);
+	}
+
+	return 0;
+}
+struct waitlock_fault_data {
+	struct vm_fault *vmf;
+	struct file **fpin;
+};
+static int transfer_waitlock_fault(struct folio *folio, void *userdata)
+{
+	struct waitlock_fault_data *data = userdata;
+
+	/* If the folio is not locked anymore, the "trylock" "succeeded" */
+	if (folio_test_locked(folio)) {
+		*data->fpin = maybe_unlock_mmap_for_io(data->vmf, *data->fpin);
+		folio_put_wait_locked(folio, TASK_UNINTERRUPTIBLE);
+		return -EAGAIN;
+	}
+	return 0;
+}
+static int filemap_transfer_async_accessed_state_fault(struct vm_fault *vmf,
+		struct address_space *mapping, struct folio *folio,
+		struct file **fpin)
+{
+	int ret;
+	off_t start_idx;
+	off_t end_idx;
+	struct xarray *bits_arr;
+
+	/*
+	 * this function has to mimic the lock_folio_maybe_drop_mmap because
+	 * the async readahead, if not completed, does still hold the folio
+	 * lock, which is resolved in there and not before.
+	 */
+
+	if (!mapping->i_mm_async_mimic_mapping)
+		return 0;
+	if (!current)
+		return 0;
+
+	start_idx = folio_index(folio);
+	end_idx = start_idx + folio_nr_pages(folio) - 1;
+
+	ret = filemap_get_access_bitmask(mapping, current->mm, &bits_arr);
+	if (ret)
+		return ret;
+
+	struct waitlock_fault_data waitlock_fault_data  = {
+		.vmf = vmf,
+		.fpin = fpin,
+	};
+	__filemap_transfer_async_accessed_state(mapping, start_idx, end_idx, bits_arr, transfer_waitlock_fault, &waitlock_fault_data);
+
+
+	return 0;
+}
+static int filemap_test_accessed_fault(struct address_space *mapping, off_t off, off_t len)
+{
+	int ret;
+	struct mm_struct *mm;
+	struct xarray *bits_arr;
+	size_t folio_non_accessed;
+
+	mm = current ? current->mm : NULL;
+	if (!mm)
+		return 0;
+
+	ret = filemap_get_access_bitmask(mapping, mm, &bits_arr);
+	if (ret)
+		return ret;
+
+	folio_non_accessed = 0;
+	ret = _filemap_test_accessed_bits(bits_arr, off, len, &folio_non_accessed);
+	if (ret)
+		return ret;
+
+	return (folio_non_accessed == 0) ? 0 : -ENOENT;
+}
