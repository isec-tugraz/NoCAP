+		struct folio *folio, struct file **fpin)
+{
+	int err = 0;
+	bool did_sync_io = false;
+	struct folio *new_folio;
+	struct file *file = vmf->vma->vm_file;
+	struct file_ra_state *ra = &file->f_ra;
+	vm_flags_t vm_flags = vmf->vma->vm_flags;
+	off_t start, end;
+	struct address_space *fake_mapping;
+
+	if (!current)
+		return 0;
+
+	err = filemap_get_access_sync_mimic_mapping(mapping, current->mm, &fake_mapping);
+	if (err)
+		return err;
+
+	/*
+	 * This is analog to do_sync_map_readahead and the
+	 * page_not_uptodate pathway because they interplay a lot:
+	 * - At first we see if we want to do readahead at all according
+	 *   to the VMA flags. If not, readahead is skipped
+	 * - If too many folios were missed, readahead is also skipped
+	 * - If no readahead was performed, a new folio is allocated
+	 *   (FGP_CREAT|FGP_FOR_MMP), acquired, locked but is not uptodate.
+	 *   -> page_not_uptodate fills the page
+	 */
+
+	/*
+	 * If we don't want any read-ahead, don't bother. VM_EXEC case below is
+	 * already intended for random access.
+	 */
+	if ((vm_flags & (VM_RAND_READ | VM_EXEC)) == VM_RAND_READ)
+		goto single_folio_read;
+	if (!ra->ra_pages)
+		goto single_folio_read;
+	// TODO: LOTSAMISS (probably with separate readahead state)
+
+	/*
+	 * We did not bail out of readahead - the readahead if we want
+	 * non-sequential behaviour
+	 */
+	DEFINE_READAHEAD(ractl, file, ra, fake_mapping, vmf->pgoff);
+
+	if (!(vm_flags & VM_SEQ_READ)) {
+		_sync_mmap_readahead_prepare_ra(ra, vmf);
+	} // TODO: separate readahead state for mimick
+
+	*fpin = maybe_unlock_mmap_for_io(vmf, *fpin);
+
+	if (!(vm_flags & VM_SEQ_READ)) {
+		ractl._index = ra->start;
+		/* page_cache_ra_order does alloc pages and add accessed bits */
+		page_cache_ra_order(&ractl, ra);
+	} else {
+		page_cache_sync_ra(&ractl, ra->ra_pages);
+	}
+
+	// Start and end depends on the readahead state when we did I/O
+	did_sync_io = true;
+	start = ra->start;
+	end = start + (ra->size - ra->async_size) - 1;
+	
+single_folio_read:
+	filemap_invalidate_lock_shared(fake_mapping);
+	new_folio = __filemap_get_folio(fake_mapping, vmf->pgoff,
+				  FGP_CREAT | FGP_FOR_MMAP,
+				  vmf->gfp_mask);
+	if (IS_ERR(new_folio)) {
+		err = -ENOMEM;
+		filemap_invalidate_unlock_shared(fake_mapping);
+		goto out_err;
+	}
+
+	/* In case we did no sync I/O, we'll only read a single folio */
+	if (!did_sync_io) {
+		start = folio_index(new_folio);
+		end = start + folio_nr_pages(new_folio) - 1;
+	}
+
+	if (folio_test_uptodate(new_folio))
+		goto cleanup_fake_mapping;
+
+	*fpin = maybe_unlock_mmap_for_io(vmf, *fpin);
+	/* filemap_read_folio waits (killable) for the locked bit. */
+	folio_lock(new_folio);
+
+	/* Maybe it has been brought uptodate by now by the previous lock owner? */
+	if (folio_test_uptodate(new_folio)) {
+		folio_unlock(new_folio);
+		goto cleanup_fake_mapping;
+	}
+
+	err = filemap_read_folio(file, mapping->a_ops->read_folio, new_folio);
+
+cleanup_fake_mapping:
+
+	readahead_apply_fake_mapping_pages(fake_mapping, mapping, start, end);
+
+	/*
+	 * Unlock the invalidate_lock to allow truncation, put the folio afterwards.
+	 * This maintains the lock protocol that was established as described in
+	 * filemap_create_folio.
+	 * Then we can finally request the read pages to be invalidated.
+	 */
+	filemap_invalidate_unlock_shared(fake_mapping);
+	folio_put(new_folio);
+	invalidate_mapping_pages(fake_mapping, start, end);
+
+out_err:
+	return err;
+}
+static int filemap_mimick_async_fault(struct vm_fault *vmf,
+		struct address_space *mapping,
+		struct folio *folio, struct file **fpin)
+{
+	struct inode *inode = mapping->host;
+	struct file *file = vmf->vma->vm_file;
+	struct file_ra_state *ra = &file->f_ra;
+	pgoff_t end_index = (i_size_read(inode) - 1) >> PAGE_SHIFT;
+
+	if (!current)
+		return 0;
+
+	/* only do readahead on the first try */
+	if ((vmf->flags & FAULT_FLAG_TRIED))
+		return 0;
+
+	/* If we don't want any read-ahead, don't bother */
+	if (vmf->vma->vm_flags & VM_RAND_READ || !ra->ra_pages)
+		return 0;
+
+	if (!mapping->i_mm_async_mimic_mapping) {
+		struct address_space *fake_mapping = kmalloc(sizeof(*fake_mapping), GFP_KERNEL);
+		if (!fake_mapping)
+			return -ENOMEM;
+
+		readahead_init_fake_mapping(fake_mapping, mapping);
+		mapping->i_mm_async_mimic_mapping = fake_mapping;
+	}
+
+	// TODO: FLAG HANDLING (readahead)!!!!
+	pgoff_t ra_start = vmf->pgoff + 1;
+	pgoff_t ra_end = ra_start + ra->ra_pages - 1;
+
+	if (ra_start > end_index)
+		goto out_skip_io;
+
+	ra_end = min(ra_end, end_index);
+	off_t ra_size = ra_end - ra_start + 1;
+	filemap_peek_transfer_async_accessed_state(mapping, ra_start, ra_end);
+	if (filemap_test_accessed_fault(mapping, ra_start, ra_size)) {
+		*fpin = maybe_unlock_mmap_for_io(vmf, *fpin);
+
+		DEFINE_READAHEAD(ractl, file, ra, mapping->i_mm_async_mimic_mapping, ra_start);
+		page_cache_async_ra(&ractl, folio, ra_size);
+	}
+
+out_skip_io:
+	return 0;
+}
